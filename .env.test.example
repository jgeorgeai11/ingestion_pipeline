# Template for the engine test-runner credential file (gitignored):
#
#   .env.test   the LOGIN-only ingestion_test_runner role: owns the dedicated
#               ingestion_test database and nothing else; read by the test
#               suite's ephemeral_schema fixture (ingpipe_lib.testing) on
#               every `uv run pytest`.
#
# Populate it BY HAND after running create_ingestion_test_role.sql
# (MAINTAINING.packages.md §2): the password is whatever you passed the
# script as -v ingestion_test_password=... — the script uses it once to
# create the role and never writes any file.
#
# Without this file the DB-backed tests SKIP and the suite stays green, so a
# green run on an unprovisioned machine proves less than it looks like.
#
# It lives at the workspace root, beside .env.provisioning, because both are
# cluster-and-machine state rather than instance state. Same permissions rule
# as every credential file — no other local account may be able to read it:
#
#   chmod 600 .env.test          # macOS/Linux; re-apply by hand (umask 022)
#   icacls .env.test             # Windows: owner + administrators only
#
# All four variables are required.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ingestion_test_runner
POSTGRES_PASSWORD=<the value passed as -v ingestion_test_password>
